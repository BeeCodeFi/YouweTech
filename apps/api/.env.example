# ──────────────────────────────────────────────────────────────────────────────
# YouweTech API — Environment Variables
# Copy to .env.local and fill in real values
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Database (Neon — get from https://console.neon.tech)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/dbname?sslmode=require"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET="your-access-token-secret-here"
JWT_REFRESH_SECRET="your-refresh-token-secret-here"

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS="http://localhost:3000"

# Frontend URL (for redirect links in emails)
FRONTEND_URL="http://localhost:3000"

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend (get from https://resend.com/api-keys)
RESEND_API_KEY="re_..."
FROM_EMAIL="YouweTech <noreply@youwetech.com>"
ADMIN_EMAIL="admin@youwetech.com"
